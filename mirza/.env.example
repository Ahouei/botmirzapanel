# Mirza Bot — environment template
# Copy to mirza/.env or project root .env

# --- Telegram (required) ---
MIRZA_TG__BOT_TOKEN=123456:AAHfake-token-from-BotFather
MIRZA_TG__ADMIN_IDS=[172623365]

# --- Database ---
# dev (no postgres needed):
# MIRZA_DB__DRIVER=sqlite+aiosqlite
# MIRZA_DB__NAME=mirza_dev
# prod:
MIRZA_DB__DRIVER=postgresql+asyncpg
MIRZA_DB__HOST=db
MIRZA_DB__PORT=5432
MIRZA_DB__NAME=mirza
MIRZA_DB__USER=mirza
MIRZA_DB__PASSWORD=change-me-strong

# --- Webhook / web ---
MIRZA_WEB__BASE_URL=https://bot.example.com
MIRZA_WEB__LISTEN_HOST=0.0.0.0
MIRZA_WEB__LISTEN_PORT=8080
MIRZA_WEB__WEBHOOK_SECRET=change-me-random-32

# --- App ---
# MIRZA_DEBUG=false
# MIRZA_TIMEZONE=Asia/Tehran

# --- Plugins ---
# colon-separated extra plugin dirs
# MIRZA_PLUGIN_DIRS=plugins:/opt/mirza-plugins
